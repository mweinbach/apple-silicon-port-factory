diff --git a/projects/dxilconv/include/Support/DXNonWin.h b/projects/dxilconv/include/Support/DXNonWin.h
new file mode 100644
index 00000000..10b7f0e4
--- /dev/null
+++ b/projects/dxilconv/include/Support/DXNonWin.h
@@ -0,0 +1,110 @@
+///////////////////////////////////////////////////////////////////////////////
+//                                                                           //
+// DXNonWin.h                                                                //
+// This file is distributed under the University of Illinois Open Source     //
+// License. See LICENSE.TXT for details.                                     //
+//                                                                           //
+// aw2-port: the few Windows SDK definitions dxilconv uses that neither DXC's //
+// WinAdapter nor DirectX-Headers provide on non-Windows hosts.              //
+//                                                                           //
+///////////////////////////////////////////////////////////////////////////////
+
+#pragma once
+
+#ifndef _WIN32
+
+#include <climits>
+#include <cstdint>
+#include <cstring>
+
+// d3d11.h / d3d10.h constants.
+#ifndef D3D11_SHADER_MAX_INTERFACES
+#define D3D11_SHADER_MAX_INTERFACES (253)
+#endif
+#ifndef D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT
+#define D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT (14)
+#endif
+#ifndef D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT
+#define D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT (16)
+#endif
+#ifndef D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT
+#define D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT (128)
+#endif
+#ifndef D3D11_COMMONSHADER_TEMP_REGISTER_COUNT
+#define D3D11_COMMONSHADER_TEMP_REGISTER_COUNT (4096)
+#endif
+#ifndef D3D10_REQ_CONSTANT_BUFFER_ELEMENT_COUNT
+#define D3D10_REQ_CONSTANT_BUFFER_ELEMENT_COUNT (4096)
+#endif
+
+// basetsd.h types WinAdapter lacks.
+typedef int64_t INT64;
+
+#ifndef CONST
+#define CONST const
+#endif
+#ifndef _UI8_MAX
+#define _UI8_MAX 0xffu
+#endif
+
+#ifndef __override
+#define __override
+#endif
+
+// windows.h min/max (the sources call them unqualified).
+#include <algorithm>
+using std::max;
+using std::min;
+
+// Legacy SAL annotations.
+#ifndef __in_range
+#define __in_range(lo, hi)
+#endif
+#ifndef __in_ecount
+#define __in_ecount(n)
+#endif
+#ifndef __out_ecount
+#define __out_ecount(n)
+#endif
+#ifndef __field_ecount_part
+#define __field_ecount_part(size, init)
+#endif
+
+// strsafe.h
+#ifndef StringCchCopyA
+inline HRESULT StringCchCopyA(char *dst, size_t n, const char *src) {
+  if (n == 0)
+    return E_INVALIDARG;
+  size_t len = strnlen(src, n);
+  if (len == n) {
+    memcpy(dst, src, n - 1);
+    dst[n - 1] = 0;
+    return E_INVALIDARG; // STRSAFE_E_INSUFFICIENT_BUFFER
+  }
+  memcpy(dst, src, len + 1);
+  return S_OK;
+}
+#endif
+
+// ETW tracing (Windows-only) compiles away.
+#define DxcRuntimeEtw_DxcTranslate_Start()
+#define DxcRuntimeEtw_DxcTranslate_Stop(hr) (void)(hr)
+#define DxcRuntimeEtw_DxcTranslate_TranslateStats(...)
+
+// Timing for the (compiled-away) translate stats.
+#include <time.h>
+inline BOOL QueryPerformanceCounter(LARGE_INTEGER *t) {
+  t->QuadPart = (LONGLONG)clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+  return TRUE;
+}
+inline BOOL QueryPerformanceFrequency(LARGE_INTEGER *f) {
+  f->QuadPart = 1000000000;
+  return TRUE;
+}
+
+// MSVC intrinsics.
+#ifndef __assume
+#define __assume(x) __builtin_assume(x)
+#endif
+
+#endif // !_WIN32
