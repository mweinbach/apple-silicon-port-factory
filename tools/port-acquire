#!/usr/bin/env python3
"""Universal command-line game acquisition wrapper for Apple Silicon Port Factory.

Invokes pluggable store backends (e.g. Epic Games Store via `legendary`, or Steam)
through a small shared interface (`tools/port_acquire/backend.py`).
"""

from __future__ import annotations

import sys
from pathlib import Path

_TOOLS_DIR = Path(__file__).resolve().parent
if str(_TOOLS_DIR) not in sys.path:
    sys.path.insert(0, str(_TOOLS_DIR))

from port_acquire.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
