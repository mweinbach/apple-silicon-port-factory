# Build outputs
/target/
**/target/
*.DS_Store
__pycache__/
*.pyc

# Built app bundles (regenerated by packaging tools)
/*.app/
/*.ipa
/Alan Wake 2.app/
/Overwatch.app/

# Generated captures, logs, and scratch output
/out/
*.log

# Optional upstream reference checkouts (fetched via ./scripts/third_party.sh; no git submodules)
/third_party

# Local analysis databases (regenerated from the user's own game install)
/db/*.sqlite
/db/*.sqlite-journal
/games/*/db/*.sqlite
/games/*/db/*.sqlite-journal

# Local machine-specific agent / editor state
/.agents/mcp_config.json
/.opencode/
/.rift

# Ghidra project files (large, local)
/re/ghidra/*.rep
/re/ghidra/*.gpr
/re/ghidra/*.lock*
/out/ghidra/

# Never commit game binaries or assets
*.exe
*.dll
*.rmdblob
*.rmdtoc
*.binrfx
*.bnk
*.wem
*.bk2
*.pak
*.ucas
*.utoc
*.casc
